{
  "name": "fbr-invoicing-app",
  "version": "1.0.10",
  "description": "FBR Compliant Digital Invoicing Desktop Suite (Compliance 2026)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "release": "electron-builder --win --publish always",
    "postinstall": "node -e \"try { require('child_process').execSync('npx prebuild-install -r napi', { cwd: './node_modules/sqlite3', stdio: 'inherit' }); } catch(e){}\""
  },
  "keywords": [
    "fbr",
    "digital-invoicing",
    "pakistan-tax",
    "compliance-2026"
  ],
  "author": "Antigravity",
  "license": "ISC",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.antigravity.fbr-invoicing-app",
    "npmRebuild": false,
    "asar": true,
    "asarUnpack": [
      "**/node_modules/sqlite3/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "TahaImran1",
        "repo": "FBR-Sales-Tax-Invoicing-Desktop-Application",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "db.js",
      "style.css",
      "sqlite-db.js",
      "qrcode.min.js",
      "fbrdigitalinvoicesystemlogo.png",
      "app_logo.png"
    ],
    "directories": {
      "output": "dist"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "sqlite3": "^6.0.1"
  }
}
